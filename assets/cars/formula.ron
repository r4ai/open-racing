// Generic single-seater of the Formula 3 class: a carbon tub with a 3.4 l naturally
// aspirated V6 behind the driver, a six-speed sequential paddle-shift gearbox, and
// double wishbones at both ends worked by a pushrod (front) and a pullrod (rear) through
// rockers on the tub and the gearbox, with a third (heave) spring on each axle to hold
// the car up under downforce. Values are representative of the class, not of any
// particular car.
// Units: SI (m, kg, N, s). Angles in radians. Hardpoints are for the left wheel,
// relative to its wheel centre at static ride height: forward, left, up.
(
    name: "Formula",
    mass: 675.0,                  // incl. driver and ~half fuel
    inertia: (110.0, 720.0, 780.0),
    cg_height: 0.28,
    front_weight: 0.44,
    wheelbase: 2.85,
    track_front: 1.60,
    track_rear: 1.55,

    front: (
        tire: "velloni_zeta_f_front",
        pressure: 1.25,              // cold; ~1.6 bar hot
        unsprung_mass: 26.0,
        wheel_inertia: 0.55,
        // The arms reach in to the narrow tub; the rack sits ahead of the axle at the
        // height of the upper arm.
        linkage: DoubleWishbone(
            upper: (front: (0.12, -0.57, 0.140), rear: (-0.20, -0.55, 0.125), outer: (-0.03, -0.105, 0.155)),
            lower: (front: (0.15, -0.60, -0.115), rear: (-0.22, -0.58, -0.110), outer: (0.0, -0.07, -0.14)),
            tie_rod: (inner: (0.09, -0.58, 0.019), outer: (0.09, -0.08, 0.02)),
        ),
        // The pushrod runs from the lower arm near its ball joint up to a rocker on top
        // of the tub, which works a damper lying across the car.
        actuation: Rocker(
            rod: (-0.02, -0.10, -0.12),
            on: LowerArm,
            pivot: (-0.02, -0.52, 0.20),
            axis: (1.0, 0.0, 0.0),
            rod_end: (-0.02, -0.46, 0.24),
            spring_end: (-0.02, -0.52, 0.28),
            chassis: (-0.02, -0.76, 0.29),
        ),
        spring_rate: 260000.0,       // at the damper; ~150 N/mm at the wheel
        bump_damping: 11000.0,
        rebound_damping: 16000.0,
        fast_bump_damping: Some(4500.0),
        fast_rebound_damping: Some(7000.0),
        damper_knee: 0.05,
        anti_roll_rate: 140000.0,
        heave: Some((rate: 340000.0, damping: 4000.0)),
        bump_travel: 0.025,
        droop_travel: 0.040,
        bump_stop_rate: 1500000.0,
        static_camber: -0.052,       // -3.0 deg
        static_toe: -0.001,          // a little toe-out for the turn-in
    ),

    rear: (
        tire: "velloni_zeta_f_rear",
        pressure: 1.25,
        unsprung_mass: 30.0,
        wheel_inertia: 0.75,
        linkage: DoubleWishbone(
            upper: (front: (0.15, -0.52, 0.15), rear: (-0.10, -0.50, 0.15), outer: (0.02, -0.10, 0.16)),
            lower: (front: (0.25, -0.56, -0.100), rear: (-0.15, -0.54, -0.130), outer: (0.0, -0.07, -0.15)),
            tie_rod: (inner: (-0.14, -0.52, 0.014), outer: (-0.14, -0.08, 0.0)),
        ),
        // The pullrod runs from the upper arm down to a rocker low on the gearbox case.
        actuation: Rocker(
            rod: (0.0, -0.14, 0.14),
            on: UpperArm,
            pivot: (0.0, -0.55, -0.12),
            axis: (1.0, 0.0, 0.0),
            rod_end: (0.0, -0.52, -0.06),
            spring_end: (0.0, -0.55, -0.19),
            chassis: (0.0, -0.76, -0.19),
        ),
        spring_rate: 310000.0,
        bump_damping: 12000.0,
        rebound_damping: 18000.0,
        fast_bump_damping: Some(5000.0),
        fast_rebound_damping: Some(8000.0),
        damper_knee: 0.05,
        anti_roll_rate: 90000.0,
        heave: Some((rate: 420000.0, damping: 5000.0)),
        bump_travel: 0.030,
        droop_travel: 0.045,
        bump_stop_rate: 1500000.0,
        static_camber: -0.031,       // -1.8 deg
        static_toe: 0.002,
    ),

    steering: (
        ratio: 11.0,
        lock: 3.0,                   // 170 deg each way
    ),

    brakes: (
        max_torque: 6500.0,
        front_bias: 0.58,
        pad_friction: [
            (0.0, 0.65), (150.0, 0.85), (350.0, 1.0), (650.0, 1.0), (800.0, 0.85), (950.0, 0.6),
        ],
        disc_mass: Some((3.8, 3.2)),     // ventilated iron, about 280 mm
        disc_cooling: Some((55.0, 45.0)),    // ducted
        fluid_boiling_point: 320.0,
        start_temperature: 250.0,
    ),

    engine: (
        torque_curve: [
            (1000.0, 180.0), (2000.0, 240.0), (3000.0, 300.0), (4000.0, 350.0),
            (5000.0, 385.0), (6000.0, 390.0), (7000.0, 375.0), (8000.0, 340.0),
            (8500.0, 315.0),
        ],
        drag_curve: [
            (0.0, 12.0), (1000.0, 16.0), (3000.0, 28.0), (6000.0, 50.0), (8500.0, 75.0),
        ],
        inertia: 0.10,
        idle_rpm: 2000.0,
        limiter_rpm: 8250.0,
        stall_rpm: 900.0,
        cooling: (fan: false),       // sidepod radiators only: it overheats standing still
        position: Mid,
    ),

    clutch: (
        max_torque: 600.0,
    ),

    gearbox: (
        ratios: [2.75, 2.07, 1.67, 1.40, 1.18, 1.00],
        reverse: 2.9,
        final_drive: 3.2,
        efficiency: 0.93,
        kind: Sequential(
            shift_time: 0.04,
            dog_release_torque: 120.0,
        ),
    ),

    electronics: (
        anti_stall: Some((rpm: 1400.0)),
        auto_blip: true,
        ignition_cut: true,
        downshift_protection_rpm: Some(8400.0),
    ),

    differential: (
        preload: 60.0,
        power_ramp: 0.40,
        coast_ramp: 0.30,
    ),

    // At rest and 0 pitch the elements give about 0.8 / 1.4 m² of downforce area on the
    // front / rear wings and the floor, and 0.95 m² of drag area (the open wheels
    // included). The front wing and the floor work in ground effect; the rear wing
    // follows its angle of attack.
    aero: (
        ride_height: (0.030, 0.055),
        elements: [
            (name: "body", position: (0.0, 0.25), area: 0.55, lift: [(0.0, 0.0)], drag: [(0.0, 1.0)]),
            (
                name: "front wing",
                position: (2.30, -0.18),
                area: 0.80,
                angle: 0.05,
                lift: [(-0.1, 0.55), (0.05, 1.0), (0.2, 1.3), (0.3, 1.25)],
                drag: [(-0.1, 0.08), (0.05, 0.12), (0.2, 0.2), (0.3, 0.3)],
                height_lift: [(0.0, 0.85), (0.02, 1.1), (0.045, 1.0), (0.1, 0.85), (0.2, 0.7)],
                yaw_lift: -0.2,
                damage_lift: (0.05, 0.0, 0.015, 0.015),
                damage_drag: (0.02, 0.0, 0.0, 0.0),
            ),
            (
                name: "floor",
                position: (-0.20, -0.25),
                area: 3.5,
                lift: [(-0.05, 0.09), (0.0, 0.12), (0.05, 0.14)],
                drag: [(0.0, 0.01)],
                height_lift: [(0.01, 0.7), (0.03, 1.15), (0.0425, 1.0), (0.08, 0.8), (0.2, 0.55)],
                yaw_lift: -0.3,
                damage_lift: (0.005, 0.01, 0.01, 0.01),
            ),
            (
                name: "rear wing",
                position: (-1.85, 0.65),
                area: 0.80,
                angle: 0.20,
                lift: [(-0.1, 0.5), (0.0, 0.85), (0.2, 1.2), (0.3, 1.35), (0.4, 1.3)],
                drag: [(-0.1, 0.1), (0.0, 0.15), (0.2, 0.3), (0.3, 0.4), (0.4, 0.55)],
                yaw_lift: -0.4,
                damage_lift: (0.0, 0.05, 0.005, 0.005),
                damage_drag: (0.0, 0.02, 0.0, 0.0),
            ),
        ],
    ),
)
