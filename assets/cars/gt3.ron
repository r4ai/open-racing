// Generic GT3-class car (front-engine-less mid/rear layout, RWD) on GT3-class slicks.
// Values are representative of the class, not of any particular model.
// Units: SI (m, kg, N, s). Angles in radians.
(
    name: "GT3",
    mass: 1330.0,                 // incl. driver and ~half fuel
    inertia: (500.0, 1900.0, 2150.0),
    cg_height: 0.42,
    front_weight: 0.45,
    wheelbase: 2.65,
    track_front: 1.65,
    track_rear: 1.62,

    front: (
        tire: "velloni_zeta_gt_front",
        pressure: 1.38,              // cold; ~1.85 bar hot (about 26.8 psi)
        unsprung_mass: 45.0,
        wheel_inertia: 1.1,
        spring_rate: 120000.0,
        bump_damping: 5500.0,
        rebound_damping: 8000.0,
        anti_roll_rate: 60000.0,
        bump_travel: 0.040,
        droop_travel: 0.070,
        bump_stop_rate: 1000000.0,
        static_camber: -0.061,       // -3.5 deg
        camber_gain: -0.5,           // double wishbones: ~0.3 deg more negative per cm of bump
    ),

    rear: (
        tire: "velloni_zeta_gt_rear",
        pressure: 1.38,
        unsprung_mass: 50.0,
        wheel_inertia: 1.4,
        spring_rate: 140000.0,
        bump_damping: 6000.0,
        rebound_damping: 9000.0,
        anti_roll_rate: 40000.0,
        bump_travel: 0.045,
        droop_travel: 0.070,
        bump_stop_rate: 1000000.0,
        static_camber: -0.044,       // -2.5 deg
        camber_gain: -0.4,
    ),

    steering: (
        ratio: 13.0,
        lock: 4.712,                 // 270 deg each way
        ackermann: 0.3,
    ),

    brakes: (
        max_torque: 11000.0,
        front_bias: 0.60,
        // Racing pads: weak cold, at their best from about 350 to 650 C, fading beyond.
        pad_friction: [
            (0.0, 0.65), (150.0, 0.85), (350.0, 1.0), (650.0, 1.0), (800.0, 0.85), (950.0, 0.6),
        ],
        disc_mass: Some((11.0, 8.5)),    // ventilated iron, about 380 / 355 mm
        disc_cooling: Some((110.0, 80.0)),   // ducted
        fluid_boiling_point: 320.0,      // racing fluid, dry
        start_temperature: 300.0,        // warmed on the way to the grid
    ),

    engine: (
        torque_curve: [
            (1000.0, 250.0), (2000.0, 320.0), (3000.0, 380.0), (4000.0, 420.0),
            (5000.0, 450.0), (6000.0, 470.0), (7000.0, 465.0), (8000.0, 450.0),
            (8750.0, 430.0), (9500.0, 380.0),
        ],
        drag_curve: [
            (0.0, 15.0), (1000.0, 20.0), (3000.0, 35.0), (6000.0, 60.0), (9500.0, 95.0),
        ],
        inertia: 0.20,
        idle_rpm: 1500.0,
        limiter_rpm: 9250.0,
        stall_rpm: 700.0,
        cooling: (fan: false),       // no radiator fan: it overheats standing still
        position: Mid,
    ),

    clutch: (
        max_torque: 900.0,
    ),

    gearbox: (
        ratios: [3.15, 2.37, 1.93, 1.62, 1.39, 1.20],
        reverse: 3.0,
        final_drive: 3.4,
        efficiency: 0.92,
        kind: Sequential(
            shift_time: 0.05,
            dog_release_torque: 150.0,
        ),
    ),

    // Paddle-shift and engine electronics of a GT3 car.
    electronics: (
        anti_stall: Some((rpm: 1100.0)),
        auto_blip: true,
        ignition_cut: true,
        downshift_protection_rpm: Some(9000.0),
    ),

    differential: (
        preload: 100.0,
        power_ramp: 0.35,
        coast_ramp: 0.25,
    ),

    // At rest and 0 pitch the elements give 1.2 / 1.8 m² of downforce area front / rear
    // and 0.85 m² of drag area. The splitter and the floor work in ground
    // effect (most downforce a little below the static ride height, stalling lower); the
    // wing follows its angle of attack, which the car's pitch changes.
    aero: (
        ride_height: (0.065, 0.090),
        elements: [
            (name: "body", position: (0.0, 0.10), area: 0.57, lift: [(0.0, 0.0)], drag: [(0.0, 1.0)]),
            (
                name: "splitter",
                position: (2.10, -0.36),
                area: 1.0,
                lift: [(-0.1, 0.75), (0.0, 1.03), (0.1, 1.25)],
                drag: [(-0.1, 0.04), (0.0, 0.05), (0.1, 0.07)],
                height_lift: [(0.0, 0.95), (0.02, 1.12), (0.059, 1.0), (0.1, 0.8), (0.2, 0.6)],
                yaw_lift: -0.3,
                damage_lift: (0.03, 0.0, 0.01, 0.01),
            ),
            (
                name: "floor",
                position: (-0.20, -0.35),
                area: 3.0,
                lift: [(-0.05, 0.21), (0.0, 0.257), (0.05, 0.30)],
                drag: [(0.0, 0.0167)],
                height_lift: [(0.02, 0.7), (0.045, 1.15), (0.0806, 1.0), (0.12, 0.82), (0.25, 0.55)],
                yaw_lift: -0.3,
                damage_lift: (0.005, 0.01, 0.01, 0.01),
            ),
            (
                name: "rear wing",
                position: (-2.00, 0.80),
                area: 0.9,
                angle: 0.14,             // 8 deg
                lift: [(-0.1, 0.55), (0.0, 0.95), (0.14, 1.333), (0.25, 1.6), (0.35, 1.55)],
                drag: [(-0.1, 0.07), (0.0, 0.1), (0.14, 0.2), (0.25, 0.3), (0.35, 0.45)],
                yaw_lift: -0.5,
                damage_lift: (0.0, 0.04, 0.005, 0.005),
                damage_drag: (0.0, 0.02, 0.0, 0.0),
            ),
        ],
    ),
)
