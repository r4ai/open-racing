// Generic mid-engined rear-wheel-drive (MR) sports coupé: the same 3.0 l engine as
// `fr_coupe.ron`, but between the cabin and the rear axle, 58 % of the weight on the rear.
// With the heavy masses near the centre, the moments of inertia about pitch and yaw are
// ~20 % lower: it turns in and rotates quicker, puts more power down, and lets go sooner
// once the rear slides.
// Values are representative of the class, not of any particular model.
// Units: SI (m, kg, N, s). Angles in radians.
(
    name: "MR coupe",
    mass: 1420.0,                 // incl. driver and ~half fuel
    inertia: (450.0, 1720.0, 1850.0),
    cg_height: 0.45,
    front_weight: 0.42,
    wheelbase: 2.50,
    track_front: 1.58,
    track_rear: 1.60,

    front: (
        tire: "velloni_strada_r",
        pressure: 2.2,
        unsprung_mass: 40.0,
        wheel_inertia: 0.9,
        spring_rate: 33000.0,
        bump_damping: 2500.0,
        rebound_damping: 3600.0,
        anti_roll_rate: 26000.0,
        bump_travel: 0.060,
        droop_travel: 0.090,
        bump_stop_rate: 500000.0,
        static_camber: -0.026,       // -1.5 deg
    ),

    rear: (
        tire: "velloni_strada_r_265",
        pressure: 2.2,
        unsprung_mass: 42.0,
        wheel_inertia: 1.0,
        spring_rate: 53000.0,
        bump_damping: 3500.0,
        rebound_damping: 5000.0,
        anti_roll_rate: 22000.0,
        bump_travel: 0.060,
        droop_travel: 0.090,
        bump_stop_rate: 500000.0,
        static_camber: -0.031,       // -1.8 deg
    ),

    steering: (
        ratio: 13.0,
        lock: 6.28,                  // 360 deg each way
        ackermann: 0.5,
    ),

    brakes: (
        max_torque: 7500.0,
        front_bias: 0.56,
    ),

    engine: (
        torque_curve: [
            (1000.0, 250.0), (2000.0, 380.0), (3000.0, 430.0), (4500.0, 450.0),
            (6500.0, 430.0), (7500.0, 380.0),
        ],
        drag_curve: [
            (0.0, 14.0), (1000.0, 18.0), (3000.0, 30.0), (5000.0, 45.0), (7500.0, 70.0),
        ],
        inertia: 0.20,
        idle_rpm: 850.0,
        limiter_rpm: 7400.0,
        stall_rpm: 500.0,
        position: Mid,               // its bay heats the rear tyres
    ),

    clutch: (
        max_torque: 700.0,
    ),

    gearbox: (
        ratios: [3.13, 2.10, 1.55, 1.23, 1.00, 0.83],
        reverse: 3.2,
        final_drive: 3.73,
        efficiency: 0.92,
        kind: Sequential(
            shift_time: 0.10,
            dog_release_torque: 100.0,
        ),
    ),

    drive: Rear,

    // Paddle shift cuts the ignition to unload the dogs on upshifts.
    electronics: (
        ignition_cut: true,
    ),

    differential: (
        preload: 60.0,
        power_ramp: 0.30,
        coast_ramp: 0.15,
    ),

    // The body's drag and lift at the axles; a road car's barely change with its attitude.
    aero: (
        ride_height: (0.13, 0.14),
        elements: [
            (name: "body", position: (0.0, 0.12), area: 0.68, lift: [(0.0, 0.0)], drag: [(0.0, 1.0)]),
            (name: "front", position: (1.4500, 0.0), area: 0.05, lift: [(0.0, 1.0)], drag: [(0.0, 0.0)]),
            (name: "rear", position: (-1.0500, 0.0), area: 0.08, lift: [(0.0, 1.0)], drag: [(0.0, 0.0)]),
        ],
    ),
)
