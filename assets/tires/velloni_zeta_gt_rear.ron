// Velloni Zeta GT, a fictional GT3-class dry slick, rear size 31/71-18.
// Size and behaviour follow public figures for GT3 slicks (hot pressure window, operating
// temperature, pressure rise); not the data of any real tyre.
// Units: SI (m, N, s), angles in radians, temperatures in °C, pressures in bar (gauge).
(
    name: "Velloni Zeta GT 31/71-18 (rear)",
    radius: 0.355,
    width: 0.310,
    vertical_stiffness: 300000.0,    // at the optimal hot pressure
    vertical_damping: 400.0,
    mu_x: 1.65,
    mu_y: 1.60,
    nominal_load: 4000.0,
    load_exponent_x: 0.88,          // friction force ∝ load^exponent
    load_exponent_y: 0.88,
    longitudinal: (peak_slip: 0.10, shape: 1.65, curvature: 0.3),
    lateral: (peak_slip: 0.105, shape: 1.45, curvature: 0.3),   // ~6.0 deg
    relaxation_x: 0.15,
    relaxation_y: 0.35,
    camber_thrust: 0.12,
    optimal_camber: -0.030,
    camber_grip_loss: 20.0,
    pneumatic_trail: 0.035,
    rolling_resistance: 0.012,

    pressure: (
        optimal: 1.85,                   // hot, ~26.8 psi; the window is roughly 26-27.5 psi
        window: 0.25,
        grip_loss: 0.12,
        stiffness_per_bar: 85000.0,
        peak_slip_per_bar: -0.15,
        rolling_resistance_per_bar: -0.3,
        crown_load_per_bar: 1.0,
    ),

    thermal: (
        // Grip against the tread surface temperature, °C.
        grip_curve: [(-10.0, 0.853), (27.5, 0.881), (60.0, 0.955), (90.0, 1.0), (111.0, 0.955), (133.75, 0.881), (160.0, 0.853)],
        wear_window: 35.0,
        start_temperature: 75.0,         // out of the tyre blankets
        surface_capacity: 1600.0,
        core_capacity: 16000.0,
        core_conductance: 125.0,
        zone_conductance: 25.0,
        air_cooling: 5.0,
        air_cooling_per_speed: 1.0,
        road_cooling: 30.0,
        slide_heat_share: 0.5,
        rolling_heat_share: 0.5,
        camber_load_shift: 6.0,
        carcass_roll: 0.03,
        wear_rate: 0.02,
        wear_grip_loss: 0.1,
    ),
)
